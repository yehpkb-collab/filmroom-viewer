{
  "manifest_version": 3,
  "name": "Film Room v0.9c",
  "version": "0.9.3",
  "version_name": "0.9c",
  "description": "Timed notes, quick bookmarks and labeled shapes on YouTube videos, with share links. Alt+B bookmark, Alt+N note, Alt+A draw, Alt+H hide, Alt+S share.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/01-config.js",
        "src/02-state.js",
        "src/03-helpers.js",
        "src/04-codec.js",
        "src/05-storage.js",
        "src/06-ui.js",
        "src/07-actions.js",
        "src/08-backup.js",
        "src/09-firstrun.js",
        "src/10-panel.js",
        "src/11-shapes.js",
        "src/12-loop.js",
        "src/13-main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://filmroom-viewer.netlify.app/*"
      ],
      "js": [
        "src/01-config.js",
        "src/02-state.js",
        "src/03-helpers.js",
        "src/04-codec.js",
        "src/05-storage.js",
        "src/06-ui.js",
        "src/07-actions.js",
        "src/08-backup.js",
        "src/09-firstrun.js",
        "src/10-panel.js",
        "src/11-shapes.js",
        "src/12-loop.js",
        "src/13-main.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Film Room: click to turn the docked panel on or off",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
